# MiniLedger Backend Environment Configuration Template
# Copy this file to .env and configure with your credentials.

# ----------------------------------------------------
# Server Configuration
# ----------------------------------------------------
PORT=5000
NODE_ENV=development

# ----------------------------------------------------
# Database Configuration (Neon PostgreSQL)
# ----------------------------------------------------
# PostgreSQL connection string with SSL required for Neon.
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ----------------------------------------------------
# Authentication Configuration
# ----------------------------------------------------
# Secret key used for signing and verifying JWT tokens (HS256).
# In production, must be at least 32 characters long.
JWT_SECRET="generate_a_secure_random_64_character_hex_string_here"

# ----------------------------------------------------
# SMS OTP Delivery Configuration
# ----------------------------------------------------
# Choose SMS provider: "twilio", "msg91", or leave blank for local development terminal logging.
# In production, set to either "twilio" or "msg91".

# Option A: Twilio Credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_VERIFY_SERVICE_SID=your_verify_service_SID

# ----------------------------------------------------
# Receipt Media Storage Configuration
# ----------------------------------------------------
# Cloudinary credentials for permanent, secure image storage.
# If omitted in development, uploaded receipts fall back to local disk storage in /uploads.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
