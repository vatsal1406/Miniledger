datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loans     Loan[]

  @@map("users")
}

model OtpRecord {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_records")
}

model Loan {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendName       String
  amount           Decimal     @db.Decimal(12, 2)
  amountRepaid     Decimal     @default(0.00) @db.Decimal(12, 2)
  remainingBalance Decimal     @db.Decimal(12, 2)
  dueDate          DateTime
  status           String      @default("ACTIVE") // ACTIVE, PARTIALLY_REPAID, REPAID, OVERDUE
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  repayments       Repayment[]
  receipt          Receipt?

  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@map("loans")
}

model Repayment {
  id            String   @id @default(uuid())
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(12, 2)
  repaymentDate DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  @@index([loanId])
  @@map("repayments")
}

model Receipt {
  id               String   @id @default(uuid())
  loanId           String   @unique
  loan             Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  url              String
  publicId         String?
  originalFilename String?
  mimeType         String?
  sizeBytes        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([loanId])
  @@map("receipts")
}
